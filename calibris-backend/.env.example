# Pooled connection (used by the app at runtime) - Supabase pgbouncer port 6543
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Direct connection (used for migrations / schema push) - port 5432
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Supabase Storage (optional). If omitted, backend falls back to local disk
# storage served from http://localhost:3000/uploads
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="calibris-uploads"

# Server
PORT=3000

# Public URL for locally-stored file links (certificate PDFs, photos) when
# Supabase Storage isn't configured. On Railway this is auto-derived from
# RAILWAY_PUBLIC_DOMAIN; set explicitly only for a custom domain.
PUBLIC_BASE_URL=""
